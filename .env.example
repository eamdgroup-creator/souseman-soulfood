# Copy to .env.local for local work. Set the same names in the host's environment settings.
# Public URL of the deployed site (used for canonical links, sitemap and structured data)
NEXT_PUBLIC_SITE_URL=https://souseman-soulfood.onrender.com
# 1 = preview: tells search engines not to index the site. Set to 0 only after the owner approves.
NEXT_PUBLIC_PREVIEW=1
# No secrets are needed: the site is fully static (no forms, no API keys).
